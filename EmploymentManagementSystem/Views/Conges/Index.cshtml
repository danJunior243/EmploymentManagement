@using EmploymentManagement.Data.Entities
@using EmploymentManagement.BLL.Outils
@model EmploymentManagementSystem.Models.CongesIndexViewModel

<h2>Demandes de congé</h2>

@if (TempData["Succes"] != null)
{
    <div class="alert alert-success">@TempData["Succes"]</div>
}
@if (TempData["Erreur"] != null)
{
    <div class="alert alert-danger">@TempData["Erreur"]</div>
}

@if (Model.Solde != null)
{
    <div class="card mb-3">
        <div class="card-body">
            <h6 class="card-subtitle mb-3 text-muted">Mon solde de congés payés (@Model.Annee)</h6>
            <div class="row text-center">
                <div class="col"><div class="fs-4">@Model.Solde.DroitAnnuel</div><small class="text-muted">Droit annuel</small></div>
                <div class="col"><div class="fs-4">@Model.Solde.JoursPris</div><small class="text-muted">Pris (approuvés)</small></div>
                <div class="col"><div class="fs-4">@Model.Solde.JoursEnAttente</div><small class="text-muted">En attente</small></div>
                <div class="col"><div class="fs-4 fw-bold">@Model.Solde.JoursRestants</div><small class="text-muted">Restants</small></div>
            </div>
        </div>
    </div>
}

<a asp-action="Create" class="btn btn-primary mb-3">Nouvelle demande</a>

<table class="table">
    <thead>
        <tr>
            <th>Employé</th>
            <th>Type</th>
            <th>Début</th>
            <th>Fin</th>
            <th>Jours ouvrables</th>
            <th>Statut</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var conge in Model.Conges)
        {
            var badge = conge.Statut switch
            {
                StatutConge.EnAttente => "bg-warning text-dark",
                StatutConge.Approuve => "bg-success",
                StatutConge.Refuse => "bg-danger",
                _ => "bg-secondary"
            };

            <tr>
                <td>@conge.Employe?.NomEmployes</td>
                <td>@conge.Type</td>
                <td>@conge.DateDebut.ToString("yyyy-MM-dd")</td>
                <td>@conge.DateFin.ToString("yyyy-MM-dd")</td>
                <td>@OutilsDates.CompterJoursOuvrables(conge.DateDebut, conge.DateFin)</td>
                <td><span class="badge @badge">@conge.Statut</span></td>
                <td>
                    @if (User.IsInRole("Admin") && conge.Statut == StatutConge.EnAttente)
                    {
                        <form asp-action="Approuver" asp-route-id="@conge.Id" method="post" style="display:inline">
                            <button type="submit" class="btn btn-sm btn-success">Approuver</button>
                        </form>
                        <form asp-action="Refuser" asp-route-id="@conge.Id" method="post" style="display:inline">
                            <button type="submit" class="btn btn-sm btn-danger">Refuser</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>