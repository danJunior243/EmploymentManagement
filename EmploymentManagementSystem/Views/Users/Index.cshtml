@model IEnumerable<EmploymentManagementSystem.Models.UserListItemViewModel>

@{
    ViewData["Title"] = "Accounts";
}

<h2>Accounts</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<a asp-action="Create" class="btn btn-primary mb-3">New account</a>

<table class="table">
    <thead>
        <tr>
            <th>Email</th>
            <th>Employee</th>
            <th>Role</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var u in Model)
        {
            <tr>
                <td>@u.Email</td>
                <td>@(u.EmployeeName ?? "—")</td>
                <td>@u.Roles</td>
            </tr>
        }
    </tbody>
</table>